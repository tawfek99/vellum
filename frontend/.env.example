# Base URL of the FastAPI backend (public, non-secret).
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Supabase public client config.
# The anon key is safe to expose in the browser; data is protected by RLS/policies.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: one-click demo entry on the login page.
# These are public by design (the demo account only sees seeded sample data).
# Leave blank to hide the "Try the demo" button.
VITE_DEMO_EMAIL=
VITE_DEMO_PASSWORD=
