# ---- App ----
APP_NAME="Note Taker API"
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# Comma-separated list of allowed frontend origins (no spaces).
CORS_ORIGINS=http://localhost:5173

# ---- Database (Supabase Postgres) ----
# Use the connection pooler URL from Supabase. Must use the asyncpg driver.
# Example: postgresql+asyncpg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/note_taker

# ---- Supabase ----
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Legacy JWT secret used to verify Supabase-issued access tokens server-side.
SUPABASE_JWT_SECRET=
STORAGE_BUCKET=documents

# ---- AI provider (abstracted; swap via config) ----
AI_PROVIDER=deepseek
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_BASE_URL=https://api.deepseek.com
