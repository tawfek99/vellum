# ---- App ----
APP_NAME="Vellum API"
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# Comma-separated list of allowed frontend origins (no spaces).
CORS_ORIGINS=http://localhost:5173

# ---- Database (Supabase Postgres) ----
# Use the connection pooler URL from Supabase. Must use the asyncpg driver.
# Example: postgresql+asyncpg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/note_taker

# ---- Supabase ----
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Legacy HS256 JWT secret. Used to verify tokens when the project signs them
# symmetrically. Asymmetric tokens (ES256/RS256) are verified via the project's
# public JWKS URL (derived from SUPABASE_URL) instead, so this may be blank.
SUPABASE_JWT_SECRET=
STORAGE_BUCKET=documents

# ---- AI provider (abstracted; swap via config) ----
AI_PROVIDER=deepseek
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_BASE_URL=https://api.deepseek.com
